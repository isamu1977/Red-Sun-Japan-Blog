---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import booksCatalog from "@/data/booksCatalog.json";

type BookCatalogEntry = {
  published?: boolean;
  volume_label?: string;
  title?: string;
  subtitle?: string;
  kofi_ebook_url?: string;
  kofi_audiobook_url?: string;
  kofi_shop_url?: string;
  kofi_tip_url?: string;
  amazon_kdp_url?: string;
};

type Props = {
  volume?: string | number | null;
};

const { volume } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const normalizedVol =
  volume !== undefined && volume !== null && String(volume).trim() !== ""
    ? String(volume).trim().padStart(2, "0")
    : null;

const catalog = booksCatalog as Record<string, BookCatalogEntry>;
const entry = normalizedVol ? catalog[normalizedVol] : undefined;
const isPublished = Boolean(entry && entry.published === true);
const amazonUrl = entry?.amazon_kdp_url?.trim() || "";
const volumeLabel = entry?.volume_label || (normalizedVol ? `Volume ${normalizedVol}` : "Volume 01");
---

{
  isPublished && entry && (
    <aside
      class="not-prose my-10 rounded-xl border border-[#27272a] bg-[#18181b] p-6 text-neutral-100 shadow-lg"
      aria-label="Anthology Volume Callout"
    >
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-[#b91c1c]" />
          <span class="font-mono text-xs font-semibold tracking-widest text-neutral-300 uppercase">
            {entry.title || "Chronicles of the Red Sun"}
          </span>
        </div>

        <p class="text-base font-medium text-white leading-relaxed">
          This chronicle is collected in {volumeLabel} — available as eBook &amp; audiobook.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          {entry.kofi_ebook_url && (
            <a
              href={entry.kofi_ebook_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md bg-[#b91c1c] px-4 py-2 text-xs font-semibold text-white shadow transition-colors hover:bg-[#991b1b]"
            >
              <span>📖 Collector&apos;s eBook (Ko-fi)</span>
            </a>
          )}

          {entry.kofi_audiobook_url && (
            <a
              href={entry.kofi_audiobook_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md border border-[#b91c1c]/60 bg-[#b91c1c]/15 px-4 py-2 text-xs font-semibold text-red-200 transition-colors hover:bg-[#b91c1c] hover:text-white"
            >
              <span>🎧 Unabridged Audiobook (Ko-fi)</span>
            </a>
          )}

          {amazonUrl && (
            <a
              href={amazonUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md border border-zinc-600 bg-zinc-800 px-4 py-2 text-xs font-semibold text-zinc-100 transition-colors hover:border-amber-500 hover:text-amber-300"
            >
              <span>📚 Buy on Amazon KDP</span>
            </a>
          )}

          <a
            href={getRelativeLocaleUrl(locale, "books")}
            class="inline-flex items-center gap-1.5 px-2 py-2 font-mono text-xs text-neutral-400 underline underline-offset-4 transition-colors hover:text-white"
          >
            <span>Explore /books →</span>
          </a>
        </div>
      </div>
    </aside>
  )
}
