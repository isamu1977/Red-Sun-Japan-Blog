---
import { NEWSLETTER_CONFIG } from "@/config";

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  aria-labelledby="newsletter-title"
  class:list={[
    "w-full border-y border-[#ded7cb] bg-[#f5f1e8] dark:border-[#27272a] dark:bg-[#111114] mt-16 sm:mt-20",
    className,
  ]}
>
  <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6">
    <!-- Hanko / Seal Badge -->
    <div class="flex items-center justify-center">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-[#b91c1c]/30 bg-[#b91c1c]/5 px-3 py-1 font-mono text-[11px] tracking-widest text-[#b91c1c] uppercase dark:border-[#ef4444]/30 dark:bg-[#ef4444]/10 dark:text-[#ef4444]"
      >
        怪談 • THE MIDNIGHT ARCHIVE
      </span>
    </div>

    <!-- Main Title -->
    <h2
      id="newsletter-title"
      class="font-display mt-3 text-2xl font-bold text-stone-900 sm:text-3xl dark:text-[#f4f4f5]"
    >
      The Midnight Archive
    </h2>

    <!-- Evocative Subtitle -->
    <p
      class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-stone-600 sm:text-base dark:text-stone-400"
    >
      Untranslated Edo-period folklore, historical ghost accounts, and restored
      feudal woodblock art delivered to your inbox every Saturday morning.
    </p>

    <!-- Subscription Form -->
    <form
      id="newsletter-form"
      class="mx-auto mt-6 max-w-md"
      novalidate
      data-listmonk-url={NEWSLETTER_CONFIG.listmonkUrl}
      data-list-uuid={NEWSLETTER_CONFIG.listUuid}
    >
      <div
        id="newsletter-inputs"
        class="flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          type="email"
          id="newsletter-email"
          name="email"
          required
          autocomplete="email"
          placeholder="Enter your email address..."
          class="w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 transition-colors placeholder:text-stone-400 focus:border-[#b91c1c] focus:ring-1 focus:ring-[#b91c1c] focus:outline-none dark:border-[#27272a] dark:bg-[#18181b] dark:text-[#f4f4f5] dark:placeholder:text-stone-500 dark:focus:border-[#b91c1c] dark:focus:ring-[#b91c1c]"
        />
        <button
          type="submit"
          id="newsletter-submit-btn"
          class="shrink-0 rounded-lg bg-[#b91c1c] px-6 py-3 text-xs font-medium tracking-wider text-white uppercase transition-colors hover:bg-[#991b1b] disabled:cursor-not-allowed disabled:opacity-70"
        >
          Enter the Archive &rarr;
        </button>
      </div>

      <!-- Success State -->
      <div
        id="newsletter-success"
        class="hidden rounded-lg border border-[#b91c1c]/30 bg-white/70 px-5 py-4 text-center text-sm font-medium text-stone-800 shadow-sm sm:text-base dark:border-[#b91c1c]/40 dark:bg-[#1a1a1e]/80 dark:text-stone-200"
      >
        🏮 Your lantern is lit. Please check your inbox (and spam folder) to
        confirm your subscription.
      </div>

      <!-- Error State -->
      <p
        id="newsletter-error"
        class="hidden mt-2 text-center text-xs font-medium text-red-600 dark:text-red-400"
        role="alert"
      >
      </p>

      <!-- Safeguard Notice -->
      <p
        id="newsletter-notice"
        class="mt-3 text-xs text-stone-500 dark:text-stone-400"
      >
        No spam. Double opt-in confirmation required. Unsubscribe with one click
        at any time.
      </p>
    </form>
  </div>
</section>

<script is:inline>
  function setupNewsletterBox() {
    const form = document.getElementById("newsletter-form");
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const emailInput = document.getElementById("newsletter-email");
    const submitBtn = document.getElementById("newsletter-submit-btn");
    const inputsContainer = document.getElementById("newsletter-inputs");
    const successMsg = document.getElementById("newsletter-success");
    const errorMsg = document.getElementById("newsletter-error");
    const notice = document.getElementById("newsletter-notice");

    const listmonkUrl = form.dataset.listmonkUrl || "https://newsletter.redsunjapan.com";
    const listUuid = form.dataset.listUuid || "";

    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (!emailInput || !submitBtn) return;

      const email = emailInput.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!email || !emailRegex.test(email)) {
        if (errorMsg) {
          errorMsg.textContent = "Please enter a valid email address.";
          errorMsg.classList.remove("hidden");
        }
        emailInput.focus();
        return;
      }

      // Transition to loading state
      submitBtn.disabled = true;
      submitBtn.textContent = "Lighting the lantern...";
      if (errorMsg) errorMsg.classList.add("hidden");

      try {
        const cleanBaseUrl = listmonkUrl.replace(/\/+$/, "");
        const endpoint = `${cleanBaseUrl}/api/public/subscription`;

        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            email,
            list_uuids: listUuid ? [listUuid] : [],
          }),
        });

        if (response.ok) {
          if (inputsContainer) inputsContainer.classList.add("hidden");
          if (notice) notice.classList.add("hidden");
          if (errorMsg) errorMsg.classList.add("hidden");
          if (successMsg) successMsg.classList.remove("hidden");
        } else {
          let failureMessage =
            "Unable to subscribe at this moment. Please try again.";
          try {
            const data = await response.json();
            if (data && data.message) {
              failureMessage = data.message;
            }
          } catch {}

          if (errorMsg) {
            errorMsg.textContent = failureMessage;
            errorMsg.classList.remove("hidden");
          }
          submitBtn.disabled = false;
          submitBtn.innerHTML = "Enter the Archive &rarr;";
        }
      } catch (err) {
        if (errorMsg) {
          errorMsg.textContent =
            "Connection error. Please check your network and try again.";
          errorMsg.classList.remove("hidden");
        }
        submitBtn.disabled = false;
        submitBtn.innerHTML = "Enter the Archive &rarr;";
      }
    });
  }

  // Handle standard page loads and Astro View Transitions
  setupNewsletterBox();
  document.addEventListener("astro:page-load", setupNewsletterBox);
</script>
