---
---

<div
  class="relative flex flex-col justify-between overflow-hidden rounded-xl border border-red-200 bg-[#f7f3ec] p-6 text-stone-900 shadow-sm shadow-stone-900/5 transition-all duration-300 hover:border-[#b91c1c]/50 hover:shadow-xl hover:shadow-black/10 dark:border-[#3f1d24] dark:bg-gradient-to-br dark:from-[#18181b] dark:to-[#271518] dark:text-white dark:shadow-xl dark:hover:border-[#b91c1c]/60 dark:hover:shadow-black/60"
>
  <!-- Atmospheric decorative background glow -->
  <div
    class="pointer-events-none absolute -right-12 -top-12 size-36 rounded-full bg-red-500/10 blur-3xl dark:bg-[#b91c1c]/15"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-10 -left-10 size-32 rounded-full bg-red-500/10 blur-2xl dark:bg-[#b91c1c]/10"
  >
  </div>

  <div>
    <div class="flex items-center gap-2">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-red-300 bg-red-100/80 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-[#b91c1c] dark:border-[#b91c1c]/40 dark:bg-[#b91c1c]/20 dark:text-[#ef4444]"
      >
        <span class="size-1.5 animate-pulse rounded-full bg-[#b91c1c] dark:bg-[#ef4444]"></span>
        Official Channel
      </span>
    </div>

    <div class="mt-4 flex items-center gap-3">
      <div
        class="flex size-11 items-center justify-center rounded-lg bg-[#b91c1c] text-white shadow-md shadow-[#b91c1c]/20"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-6 stroke-current"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path
            d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8z"
          ></path>
          <path d="M10 9l5 3l-5 3z"></path>
        </svg>
      </div>
      <div>
        <h4 class="font-display text-lg font-bold leading-snug text-stone-900 dark:text-[#e2ded7]">
          Red Sun Japan
        </h4>
        <p class="font-mono text-xs text-stone-500 dark:text-[#a1a1aa]">@redsunjapan</p>
      </div>
    </div>

    <h3
      class="font-display mt-4 text-xl font-bold leading-snug tracking-tight text-stone-900 dark:text-[#e2ded7]"
    >
      Experience the audio-visual chronicles on YouTube
    </h3>

    <p class="mt-2 text-xs leading-relaxed text-stone-600 dark:text-[#a1a1aa]">
      Immersive narrations, period sound design, and animated archival artwork on
      @redsunjapan.
    </p>
  </div>

  <div class="mt-6 border-t border-red-200/80 pt-4 dark:border-[#27272a]/60">
    <a
      href="https://www.youtube.com/@redsunjapan?sub_confirmation=1"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#b91c1c] px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-white shadow transition-all duration-200 hover:bg-[#9e1b1b] hover:shadow-lg hover:shadow-[#b91c1c]/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b91c1c]"
    >
      <span>Subscribe to Channel</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform duration-200 group-hover:translate-x-0.5"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M17 7l-10 10"></path>
        <path d="M8 7l9 0l0 9"></path>
      </svg>
    </a>
  </div>
</div>
