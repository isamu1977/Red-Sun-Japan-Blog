---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
const aboutUrl = getRelativeLocaleUrl(locale ?? "en", "about");
const privacyUrl = getRelativeLocaleUrl(locale ?? "en", "privacy");
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between gap-4 border-t py-6 sm:flex-row-reverse sm:gap-0 sm:py-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center gap-1.5 whitespace-nowrap text-sm sm:flex-row sm:gap-0">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <a href={aboutUrl} class="hover:text-accent transition-colors underline-offset-4 hover:underline">About</a>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <a href={privacyUrl} class="hover:text-accent transition-colors underline-offset-4 hover:underline">Privacy Policy</a>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <button
        id="manage-cookies-btn"
        type="button"
        class="cursor-pointer hover:text-accent transition-colors underline-offset-4 hover:underline"
      >
        Manage Cookie Preferences
      </button>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t.footer.allRightsReserved}</span>
    </div>
  </div>
</footer>

<script>
  function setupManageCookies() {
    const btn = document.getElementById("manage-cookies-btn");
    btn?.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("rsj:open-cookie-preferences"));
    });
  }

  setupManageCookies();
  document.addEventListener("astro:page-load", setupManageCookies);
</script>
