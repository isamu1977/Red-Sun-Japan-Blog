---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import IconYouTube from "@/assets/icons/socials/youtube.svg";
import IconKofi from "@/assets/icons/socials/kofi.svg";
import IconInstagram from "@/assets/icons/socials/instagram.svg";
import IconPinterest from "@/assets/icons/socials/pinterest.svg";
import IconX from "@/assets/icons/socials/x.svg";
import IconRss from "@/assets/icons/socials/rss.svg";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const { site } = config;
const locale = Astro.currentLocale ?? site.lang;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={[
    "w-full border-t border-stone-300 bg-[#fbf9f5] pt-12 pb-8 text-stone-700 dark:border-[#27272a] dark:bg-[#0f0f11] dark:text-[#a1a1aa]",
    noMarginTop ? "mt-0" : "mt-20",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- 4-Column Editorial Grid -->
    <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- Column 1: Brand Identity -->
      <div class="flex flex-col">
        <a
          href={getRelativeLocaleUrl(locale, "")}
          class="inline-block"
          aria-label={site.title}
        >
          <img
            src={getAssetPath("/assets/red-sun-logo-yoko-white.png")}
            alt={site.title}
            class="hidden h-10 w-auto object-contain dark:block"
            width="160"
            height="40"
            loading="lazy"
            decoding="async"
          />
          <img
            src={getAssetPath("/assets/red-sun-logo-yoko.png")}
            alt={site.title}
            class="block h-10 w-auto object-contain dark:hidden"
            width="160"
            height="40"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p
          class="mt-4 text-xs leading-relaxed text-stone-600 sm:text-sm dark:text-[#928f88]"
        >
          The digital archive of authentic Japanese Kaidan, dark folklore, and
          supernatural chronicles — translated directly from original feudal
          manuscripts.
        </p>
      </div>

      <!-- Column 2: Explore the Archive -->
      <div class="flex flex-col">
        <h3
          class="flex items-center gap-2 font-mono text-xs font-semibold tracking-widest text-stone-900 uppercase dark:text-[#e2ded7]"
        >
          <span class="inline-block size-1.5 rounded-full bg-[#b91c1c]"></span>
          EXPLORE
        </h3>
        <ul class="mt-4 flex flex-col space-y-2.5 text-xs sm:text-sm">
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class="transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              All Chronicles
            </a>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "tags/kaidan")}
              class="transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              Kaidan & Ghosts
            </a>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "tags/yokai")}
              class="transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              Yōkai Chronicles
            </a>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "tags/samurai")}
              class="transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              Samurai & Curses
            </a>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "archives")}
              class="transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              Archive Index
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Institutional & Legal -->
      <div class="flex flex-col">
        <h3
          class="flex items-center gap-2 font-mono text-xs font-semibold tracking-widest text-stone-900 uppercase dark:text-[#e2ded7]"
        >
          <span class="inline-block size-1.5 rounded-full bg-[#b91c1c]"></span>
          DOCUMENTATION
        </h3>
        <ul class="mt-4 flex flex-col space-y-2.5 text-xs sm:text-sm">
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "about")}
              class="transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              About the Archive
            </a>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "contact")}
              class="transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              Contact & Inquiries
            </a>
          </li>
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "privacy")}
              class="transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href={`${getRelativeLocaleUrl(locale, "privacy")}#affiliate`}
              class="transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              Affiliate Disclosure
            </a>
          </li>
          <li>
            <button
              id="open-cookie-settings"
              type="button"
              class="cursor-pointer text-left transition-colors hover:text-[#b91c1c] dark:hover:text-[#dc2626]"
            >
              Cookie Preferences
            </button>
          </li>
        </ul>
      </div>

      <!-- Column 4: Ecosystem & Social -->
      <div class="flex flex-col">
        <h3
          class="flex items-center gap-2 font-mono text-xs font-semibold tracking-widest text-stone-900 uppercase dark:text-[#e2ded7]"
        >
          <span class="inline-block size-1.5 rounded-full bg-[#b91c1c]"></span>
          CONNECT
        </h3>
        <div class="mt-3 flex flex-row flex-wrap items-center gap-3">
          <a
            href="https://www.youtube.com/@redsunjapan"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            title="Red Sun Japan on YouTube"
            class="group rounded-lg border border-stone-300 bg-stone-200/60 p-2.5 text-stone-700 transition-all hover:border-[#b91c1c] hover:text-[#b91c1c] dark:border-[#27272a] dark:bg-[#18181b] dark:text-[#a1a1aa] dark:hover:border-[#b91c1c] dark:hover:text-[#b91c1c]"
          >
            <IconYouTube
              class="size-5 transition-transform group-hover:scale-110"
            />
          </a>
          <a
            href="https://ko-fi.com/redsunjapan"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ko-fi"
            title="Support Red Sun Japan on Ko-fi"
            class="group rounded-lg border border-stone-300 bg-stone-200/60 p-2.5 text-stone-700 transition-all hover:border-[#b91c1c] hover:text-[#b91c1c] dark:border-[#27272a] dark:bg-[#18181b] dark:text-[#a1a1aa] dark:hover:border-[#b91c1c] dark:hover:text-[#b91c1c]"
          >
            <IconKofi
              class="size-5 transition-transform group-hover:scale-110"
            />
          </a>
          <a
            href="https://www.instagram.com/redsunjapan_official/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            title="Red Sun Japan on Instagram"
            class="group rounded-lg border border-stone-300 bg-stone-200/60 p-2.5 text-stone-700 transition-all hover:border-[#b91c1c] hover:text-[#b91c1c] dark:border-[#27272a] dark:bg-[#18181b] dark:text-[#a1a1aa] dark:hover:border-[#b91c1c] dark:hover:text-[#b91c1c]"
          >
            <IconInstagram
              class="size-5 transition-transform group-hover:scale-110"
            />
          </a>
          <a
            href="https://jp.pinterest.com/redsunjapan/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Pinterest"
            title="Red Sun Japan on Pinterest"
            class="group rounded-lg border border-stone-300 bg-stone-200/60 p-2.5 text-stone-700 transition-all hover:border-[#b91c1c] hover:text-[#b91c1c] dark:border-[#27272a] dark:bg-[#18181b] dark:text-[#a1a1aa] dark:hover:border-[#b91c1c] dark:hover:text-[#b91c1c]"
          >
            <IconPinterest
              class="size-5 transition-transform group-hover:scale-110"
            />
          </a>
          <a
            href="https://x.com/redsunjapan"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter)"
            title="Red Sun Japan on X"
            class="group rounded-lg border border-stone-300 bg-stone-200/60 p-2.5 text-stone-700 transition-all hover:border-[#b91c1c] hover:text-[#b91c1c] dark:border-[#27272a] dark:bg-[#18181b] dark:text-[#a1a1aa] dark:hover:border-[#b91c1c] dark:hover:text-[#b91c1c]"
          >
            <IconX class="size-5 transition-transform group-hover:scale-110" />
          </a>
          <a
            href={getRelativeLocaleUrl(locale, "rss.xml")}
            aria-label="RSS Feed"
            title="RSS Feed"
            class="group rounded-lg border border-stone-300 bg-stone-200/60 p-2.5 text-stone-700 transition-all hover:border-[#b91c1c] hover:text-[#b91c1c] dark:border-[#27272a] dark:bg-[#18181b] dark:text-[#a1a1aa] dark:hover:border-[#b91c1c] dark:hover:text-[#b91c1c]"
          >
            <IconRss
              class="size-5 transition-transform group-hover:scale-110"
            />
          </a>
        </div>
        <p
          class="mt-4 text-xs leading-relaxed text-stone-500 dark:text-[#71717a]"
        >
          Watch our audio-visual documentary essays on YouTube.
        </p>
      </div>
    </div>

    <!-- Bottom Sub-Footer -->
    <div
      class="flex flex-col items-center justify-between gap-3 border-t border-stone-200 pt-6 text-xs text-stone-500 sm:flex-row dark:border-[#1f1f23] dark:text-[#71717a]"
    >
      <p>© {currentYear} Red Sun Japan. All rights reserved.</p>
      <p class="text-center sm:text-right">
        Documentary preservation of Japanese feudal folklore & historical
        records.
      </p>
    </div>
  </div>
</footer>

<script>
  function setupOpenCookieSettings() {
    const btn = document.getElementById("open-cookie-settings");
    btn?.addEventListener("click", () => {
      // 1. Dispatch custom event listened by CookieConsent.astro
      window.dispatchEvent(new CustomEvent("rsj:open-cookie-preferences"));

      // 2. Call global function if exposed on window
      const globalWin = window as unknown as {
        openCookiePreferences?: () => void;
      };
      if (typeof globalWin.openCookiePreferences === "function") {
        globalWin.openCookiePreferences();
      }

      // 3. Fallback direct DOM unhide if needed
      const root = document.getElementById("rsj-cookie-root");
      const modal = document.getElementById("rsj-cookie-modal");
      if (root && modal) {
        modal.classList.remove("hidden");
        root.classList.remove("hidden", "opacity-0", "translate-y-4");
      }
    });
  }

  setupOpenCookieSettings();
  document.addEventListener("astro:page-load", setupOpenCookieSettings);
</script>
