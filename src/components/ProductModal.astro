---
// Interactive Product Details Modal for /collections
---

<div
  id="product-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pm-title"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
>
  <!-- Backdrop -->
  <div
    id="pm-backdrop"
    class="fixed inset-0 bg-black/75 backdrop-blur-sm transition-opacity"
  ></div>

  <!-- Modal Panel -->
  <div
    id="pm-panel"
    class="relative z-10 max-h-[90vh] w-full max-w-4xl overflow-y-auto rounded-2xl border border-[#ded7cb] bg-[#fbf9f5] text-stone-900 shadow-2xl transition-all dark:border-[#27272a] dark:bg-[#161619] dark:text-[#e2ded7]"
  >
    <!-- Close Button -->
    <button
      id="pm-close"
      type="button"
      aria-label="Close modal"
      class="focus-outline absolute top-4 right-4 z-20 flex size-9 cursor-pointer items-center justify-center rounded-full border border-[#ded7cb] bg-[#f3efe6] text-stone-700 transition-colors hover:border-[#b91c1c] hover:text-[#b91c1c] dark:border-[#27272a] dark:bg-[#1f1f24] dark:text-stone-300 dark:hover:border-[#dc2626] dark:hover:text-white"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>

    <div class="grid grid-cols-1 gap-6 p-6 sm:p-8 md:grid-cols-12 md:gap-8">
      <!-- Left Column: Cover & Edition Specifications -->
      <div class="flex flex-col gap-5 md:col-span-5">
        <div
          class="relative mx-auto w-full max-w-[260px] overflow-hidden rounded-md border border-stone-700/50 bg-stone-950 shadow-2xl aspect-[10/16]"
        >
          <img
            id="pm-cover"
            src=""
            alt=""
            class="h-full w-full object-cover"
          />
          <div
            id="pm-cover-fallback"
            class="hidden h-full w-full flex-col items-center justify-center bg-gradient-to-b from-[#1a1816] to-[#0c0b0a] p-6 text-center"
          >
            <span class="font-mono text-[10px] tracking-[0.25em] text-[#b91c1c] uppercase">
              Red Sun Japan Archives
            </span>
            <span id="pm-fallback-title" class="font-display mt-3 text-lg font-bold text-[#f7f4ed]"></span>
          </div>
        </div>

        <!-- Edition Specifications Table -->
        <div
          class="rounded-xl border border-[#ded7cb] bg-[#f3efe6]/70 p-4 dark:border-[#27272a] dark:bg-[#121214]/80"
        >
          <h4
            class="mb-3 font-mono text-[11px] font-semibold tracking-widest text-stone-600 uppercase dark:text-stone-400"
          >
            Edition Specifications
          </h4>
          <dl id="pm-specs" class="space-y-2 text-xs"></dl>
        </div>
      </div>

      <!-- Right Column: Title, Description, Chapters & Purchase CTAs -->
      <div class="flex flex-col md:col-span-7">
        <div class="mb-2 flex flex-wrap items-center gap-2 pr-8">
          <span
            id="pm-badge"
            class="inline-block rounded bg-[#b91c1c] px-2.5 py-0.5 font-mono text-[10px] font-bold tracking-widest text-white uppercase"
          ></span>
          <span
            id="pm-price"
            class="font-mono text-xs font-semibold text-stone-700 dark:text-amber-400/90"
          ></span>
        </div>

        <h2
          id="pm-title"
          class="font-display text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl dark:text-[#f7f4ed]"
        ></h2>
        <p
          id="pm-subtitle"
          class="mt-1 text-sm italic text-stone-600 sm:text-base dark:text-stone-400"
        ></p>

        <div
          id="pm-description"
          class="mt-4 space-y-3 text-sm leading-relaxed text-stone-700 dark:text-stone-300"
        ></div>

        <!-- Included Chronicles / Chapters -->
        <div class="mt-5">
          <h4
            class="mb-2 font-mono text-[11px] font-semibold tracking-widest text-stone-600 uppercase dark:text-stone-400"
          >
            Included Chronicles / Chapters
          </h4>
          <ul
            id="pm-contents"
            class="max-h-48 space-y-1.5 overflow-y-auto rounded-xl border border-[#ded7cb] bg-[#f3efe6]/60 p-3.5 text-xs text-stone-800 dark:border-[#27272a] dark:bg-[#121214]/80 dark:text-stone-300"
          ></ul>
        </div>

        <!-- Purchase CTAs -->
        <div id="pm-stores" class="mt-6 space-y-3"></div>

        <!-- Discrete Ko-fi Tea Footer -->
        <div
          class="mt-6 border-t border-[#ded7cb] pt-4 text-center text-xs text-stone-600 dark:border-[#27272a] dark:text-stone-400"
        >
          <a
            href="https://ko-fi.com/redsunjapan"
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-stone-400 underline-offset-4 transition-colors hover:text-[#b91c1c] dark:decoration-stone-600 dark:hover:text-[#dc2626]"
          >
            Prefer to just support our translations? Buy the Archive a Tea
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
