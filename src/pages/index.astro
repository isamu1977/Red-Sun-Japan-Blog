---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import TrendingSidebar from "@/components/TrendingSidebar.astro";
import YouTubeCard from "@/components/YouTubeCard.astro";
import Datetime from "@/components/Datetime.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { getAssetPath } from "@/utils/withBase";
import { getReadingTime } from "@/utils/getReadingTime";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

// Identify Hero Article: most recent featured post, fallback to most recent post
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const heroPost = featuredPosts[0] ?? sortedPosts[0];

// Identify Trending Chronicles: next 3 chronologically most recent after the hero
const trendingPosts = sortedPosts
  .filter(p => p.id !== heroPost?.id)
  .slice(0, 3);

// Grid posts: exclude hero + trending to avoid duplicate presentation
const excludedIds = new Set<string>([
  heroPost?.id ?? "",
  ...trendingPosts.map(p => p.id),
]);
const gridPosts = sortedPosts.filter(p => !excludedIds.has(p.id));

const homePath = getRelativeLocaleUrl(locale, "");

// Hero Post Data
const heroData = heroPost?.data;
const heroUrl = heroPost
  ? getPostUrl(heroPost.id, heroPost.filePath, locale)
  : "#";
const rawHeroCover = heroData?.heroImage ?? heroData?.ogImage;
const heroCoverSrc =
  typeof rawHeroCover === "string"
    ? getAssetPath(rawHeroCover)
    : rawHeroCover && typeof rawHeroCover === "object" && "src" in rawHeroCover
      ? (rawHeroCover.src as string)
      : undefined;
const heroPrimaryTag = heroData?.tags?.[0] ?? "Chronicle";
const heroReadingTime = heroPost ? getReadingTime(heroPost.body) : "";

const categories = [
  { id: "all", label: "All" },
  { id: "samurai", label: "Samurai" },
  { id: "yokai", label: "Yokai" },
  { id: "kaidan", label: "Kaidan" },
  { id: "history", label: "History" },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout py-8 sm:py-12"
  >
    {
      heroPost && (
        <section id="hero-article">
          <div class="mb-12 grid grid-cols-1 items-start gap-8 lg:grid-cols-12">
            <!-- Main column: Featured Chronicle (8 of 12 on lg) -->
            <div class="flex flex-col lg:col-span-8">
              <article
                id="hero-feature-card"
                class="flex flex-col gap-6 rounded-2xl border border-[#ded7cb] bg-white p-6 shadow-sm dark:border-[#27272a] dark:bg-[#161619]"
              >
                <a
                  href={heroUrl}
                  tabindex="-1"
                  aria-hidden="true"
                  class="relative block w-full overflow-hidden rounded-xl bg-stone-100 dark:bg-[#121214]"
                >
                  <div class="aspect-video w-full">
                    {heroCoverSrc ? (
                      <img
                        src={heroCoverSrc}
                        alt={heroData.title}
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="size-full object-cover transition-transform duration-700 ease-out hover:scale-105"
                      />
                    ) : (
                      <div class="flex size-full items-center justify-center bg-stone-100 text-stone-400 dark:bg-[#18181b] dark:text-[#71717a]">
                        <span class="font-display text-base tracking-widest uppercase">
                          Red Sun Japan
                        </span>
                      </div>
                    )}
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-stone-900/40 via-transparent to-transparent opacity-40 transition-opacity duration-300 hover:opacity-20 dark:from-[#121214] dark:via-black/25 dark:opacity-60 dark:hover:opacity-30" />
                  </div>
                </a>

                <div class="flex items-center gap-3">
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#b91c1c] dark:text-[#ef4444]">
                    • {heroPrimaryTag}
                  </span>
                  <span class="font-mono text-xs uppercase tracking-wider text-stone-400">
                    Featured Chronicle
                  </span>
                </div>

                <a href={heroUrl} class="focus-visible:outline-none">
                  <h2
                    transition:name={toTransitionName(heroPost.id)}
                    class="font-display text-2xl font-bold leading-tight text-stone-900 transition-colors duration-200 hover:text-[#b91c1c] sm:text-3xl dark:text-[#e2ded7] dark:hover:text-[#ef4444]"
                  >
                    {heroData.title}
                  </h2>
                </a>

                <p class="text-base leading-relaxed text-stone-600 dark:text-[#a1a1aa] line-clamp-3">
                  {heroData.description}
                </p>

                <div class="mt-auto flex items-center justify-between border-t border-stone-200 pt-4 dark:border-[#27272a]">
                  <div class="flex items-center gap-2 font-mono text-xs text-stone-500 dark:text-[#71717a]">
                    <Datetime {...heroData} />
                    <span aria-hidden="true">•</span>
                    <span>{heroReadingTime}</span>
                  </div>

                  <a
                    href={heroUrl}
                    class="inline-flex items-center gap-2 rounded-lg bg-[#b91c1c] px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider text-white shadow transition-all duration-200 hover:bg-[#9e1b1b] hover:shadow-lg hover:shadow-[#b91c1c]/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b91c1c]"
                  >
                    <span>Read Chronicle</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M5 12l14 0" />
                      <path d="M13 18l6 -6" />
                      <path d="M13 6l6 6" />
                    </svg>
                  </a>
                </div>
              </article>
            </div>

            <!-- Sidebar column: Trending Chronicles (4 of 12 on lg) -->
            <div class="flex flex-col lg:col-span-4">
              <TrendingSidebar posts={trendingPosts} />
            </div>
          </div>
        </section>
      )
    }

    <!-- Category Filter Bar -->
    <section id="category-filter-section" class="mb-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-y border-[#ded7cb] py-4 dark:border-[#27272a]/80">
        <div class="flex items-center gap-2">
          <span class="font-display text-sm font-bold uppercase tracking-widest text-stone-900 dark:text-[#e2ded7]">
            Chronicles
          </span>
          <span class="text-xs text-stone-500 font-mono dark:text-[#71717a]">/ Filter by lore</span>
        </div>

        <div class="flex flex-wrap items-center gap-2" id="category-pills">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-filter={cat.id}
              class:list={[
                "category-pill rounded-full px-4 py-1.5 font-mono text-xs font-medium uppercase tracking-wider transition-all duration-200 border",
                idx === 0
                  ? "bg-[#b91c1c] text-white border-[#b91c1c] shadow-md shadow-[#b91c1c]/20"
                  : "bg-[#f4f1ea] text-stone-600 border-[#ded7cb] hover:border-[#b91c1c]/50 hover:text-stone-900 dark:bg-[#1f1f23] dark:text-[#928f88] dark:border-[#27272a] dark:hover:text-[#e2ded7]",
              ]}
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- 3-Column Editorial Grid with injected YouTube Card -->
    <section id="articles-section" class="mb-16">
      <div
        id="articles-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      >
        {
          gridPosts.map((post, idx) => (
            <>
              <Card variant="h3" layout="grid" {...post} />
              {idx === 1 && <YouTubeCard />}
            </>
          ))
        }
        {gridPosts.length < 2 && <YouTubeCard />}
      </div>

      <div
        id="empty-filter-state"
        class="hidden rounded-xl border border-dashed border-[#ded7cb] bg-stone-50/60 py-16 text-center my-6 dark:border-[#27272a] dark:bg-transparent"
      >
        <p class="font-display text-xl text-stone-900 dark:text-[#e2ded7]">
          No chronicles found for this lore.
        </p>
        <p class="font-mono text-xs text-stone-500 dark:text-[#928f88] mt-2">
          Select "All" to view the complete historical compendium.
        </p>
      </div>

      <div class="mt-14 text-center">
        <LinkButton
          href={getRelativeLocaleUrl(locale, "posts")}
          class="inline-flex items-center gap-2 rounded-lg border border-[#ded7cb] bg-white px-6 py-3 font-mono text-xs font-bold uppercase tracking-wider text-stone-900 shadow-sm transition-all duration-200 hover:border-[#b91c1c] hover:text-[#b91c1c] hover:shadow-lg hover:shadow-black/10 dark:border-[#27272a] dark:bg-[#161619] dark:text-[#e2ded7] dark:hover:text-[#ef4444] dark:hover:shadow-black/60"
        >
          <span>Explore All Chronicles</span>
          <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initCategoryFilters() {
    const pills = document.querySelectorAll<HTMLButtonElement>(".category-pill");
    const cards = document.querySelectorAll<HTMLElement>("[data-post-card]");
    const emptyState = document.getElementById("empty-filter-state");

    if (!pills.length) return;

    const activeClasses = [
      "bg-[#b91c1c]",
      "text-white",
      "border-[#b91c1c]",
      "shadow-md",
      "shadow-[#b91c1c]/20",
    ];
    const inactiveClasses = [
      "bg-[#f4f1ea]",
      "text-stone-600",
      "border-[#ded7cb]",
      "hover:border-[#b91c1c]/50",
      "hover:text-stone-900",
      "dark:bg-[#1f1f23]",
      "dark:text-[#928f88]",
      "dark:border-[#27272a]",
      "dark:hover:text-[#e2ded7]",
    ];

    pills.forEach(pill => {
      pill.addEventListener("click", () => {
        const filter = pill.getAttribute("data-filter")?.toLowerCase() || "all";

        // Update pill active styles
        pills.forEach(p => {
          p.classList.remove(...activeClasses);
          p.classList.add(...inactiveClasses);
        });
        pill.classList.remove(...inactiveClasses);
        pill.classList.add(...activeClasses);

        let visibleCount = 0;
        cards.forEach(card => {
          const rawTags = card.getAttribute("data-tags") || "";
          const cardTags = rawTags.toLowerCase().split(" ");
          if (filter === "all" || cardTags.includes(filter)) {
            card.classList.remove("hidden");
            visibleCount++;
          } else {
            card.classList.add("hidden");
          }
        });

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove("hidden");
          } else {
            emptyState.classList.add("hidden");
          }
        }
      });
    });

    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  }

  document.addEventListener("astro:page-load", initCategoryFilters);
</script>
